# Copy to .env and fill in. Never commit .env.
DISCORD_BOT_TOKEN=

# MongoDB connection (local or Atlas). Example: mongodb://127.0.0.1:27017
MONGODB_URI=
# Optional — defaults to xp_tracker
MONGO_DB_NAME=xp_tracker

# Role name required (with Administrator) for !addxp — default DM
# XP_DM_ROLE_NAME=DM

# Max XP per !addxp command (default 100000)
# ADDXP_MAX_AMOUNT=100000
